# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# ---------------------------------------------------------------------------
# LLM provider (OpenAI-compatible)
# ---------------------------------------------------------------------------
# Agnes AI example:
#   AGNES_API_KEY=sk-...
#   AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
#   AGNES_MODEL=agnes-2.0-flash

AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash

# Optional alternative providers (uncomment / set as needed)
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama3-8b-8192

# ---------------------------------------------------------------------------
# Paths (override defaults from config/default.yaml if needed)
# ---------------------------------------------------------------------------
# SRU_MODEL_PATH=/path/to/MiniLM
# SRU_DB_PATH=./db/lancedb
# SRU_REGULATION_TABLE=university_regulation_v2
# SRU_FAQ_TABLE=QA_v2

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO
